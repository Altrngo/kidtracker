<%= form_with model: item, class: "kt-card" do |f| %>
  <% if item.errors.any? %>
    <div class="kt-error-list">
      <ul>
        <% item.errors.full_messages.each do |m| %>
          <li><%= m %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="kt-form-group">
    <%= f.label :name, "Nom de l'item", class: "kt-label" %>
    <%= f.text_field :name, class: "kt-input", placeholder: "Ex : Brossage de dents" %>
  </div>

  <div class="kt-form-group">
    <%= f.label :category, "Catégorie", class: "kt-label" %>
    <%= f.select :category,
        Item::CATEGORIES.map { |c| [c.capitalize, c] },
        { include_blank: "— Sans catégorie —" },
        class: "kt-select" %>
  </div>

  <div class="kt-form-group" style="display:flex; align-items:center; gap:.75rem;">
    <%= f.check_box :active, id: "item_active" %>
    <%= f.label :active, "Item actif", class: "kt-label", style: "margin:0; cursor:pointer" %>
  </div>

  <div style="display:flex; gap:.75rem; margin-top:1.5rem;">
    <%= f.submit item.new_record? ? "Créer l'item" : "Enregistrer", class: "kt-btn kt-btn--primary" %>
    <%= link_to "Annuler", items_path, class: "kt-btn kt-btn--ghost" %>
  </div>
<% end %>