<%# app/views/admin/users/_form.html.erb %>
<%= form_with model: [:admin, user], class: "kt-card" do |f| %>
  <% if user.errors.any? %>
    <div class="kt-error-list">
      <ul>
        <% user.errors.full_messages.each do |m| %>
          <li><%= m %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="kt-form-group">
    <%= f.label :username, "Pseudo", class: "kt-label" %>
    <%= f.text_field :username, class: "kt-input", placeholder: "Ex : papa, maman, yoann" %>
    <p class="kt-field-hint">
      Affiché dans l'historique des points pour identifier qui a effectué chaque mouvement.
    </p>
  </div>

  <div class="kt-form-group">
    <%= f.label :email, "Adresse e-mail", class: "kt-label" %>
    <%= f.email_field :email, class: "kt-input" %>
  </div>

  <div class="kt-form-group">
    <%= f.label :password, "Mot de passe", class: "kt-label" %>
    <%= f.password_field :password, class: "kt-input", autocomplete: "new-password" %>
    <p class="kt-field-hint">
      <%= user.persisted? ? "Laisser vide pour ne pas le modifier. " : "" %>12 caractères minimum.
    </p>
  </div>

  <div class="kt-form-group">
    <%= f.label :password_confirmation, "Confirmation", class: "kt-label" %>
    <%= f.password_field :password_confirmation, class: "kt-input", autocomplete: "new-password" %>
  </div>

  <div class="kt-form-group" style="display:flex; align-items:center; gap:.75rem;">
    <%= f.check_box :admin, id: "user_admin" %>
    <%= f.label :admin, "Administrateur", class: "kt-label", style: "margin:0; cursor:pointer" %>
  </div>

  <div style="display:flex; gap:.75rem; margin-top:1.5rem;">
    <%= f.submit user.new_record? ? "Créer l'utilisateur" : "Enregistrer",
          class: "kt-btn kt-btn--primary" %>
    <%= link_to "Annuler", admin_users_path, class: "kt-btn kt-btn--ghost" %>
  </div>
<% end %>
