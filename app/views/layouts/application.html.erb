<%# app/views/layouts/application.html.erb %>
<!DOCTYPE html>
<html lang="fr">
  <head>
    <title>KidTracker</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if user_signed_in? %>
      <nav class="kt-navbar">
        <%= link_to dashboard_path, class: "kt-navbar__brand" do %>
          <span class="kt-navbar__brand-img">
            <%= image_tag "family_icon.png", alt: "", width: 30, height: 30 %>
          </span>
          KidTracker
        <% end %>

        <div class="kt-navbar__nav">
          <%= link_to children_path, class: "kt-navbar__link" do %>
            👧 <span>Enfants</span>
          <% end %>
          <%= link_to stats_path, class: "kt-navbar__link" do %>
            📊 <span>Stats</span>
          <% end %>
          <%= link_to items_path, class: "kt-navbar__link" do %>
            📋 <span>Items</span>
          <% end %>
          <%= link_to privileges_path, class: "kt-navbar__link" do %>
            🎁 <span>Privilèges</span>
          <% end %>
          <% if current_user.admin? %>
            <%= link_to admin_root_path, class: "kt-navbar__admin-badge" do %>
              ⚙️ Admin
            <% end %>
          <% end %>
          <%= link_to edit_user_registration_path, class: "kt-navbar__user",
                title: "Mon compte" do %>
            <%= current_user.display_name %>
          <% end %>
          <%= link_to destroy_user_session_path,
                class: "kt-navbar__link",
                data: { turbo_method: :delete } do %>
            <span>Déconnexion</span>
          <% end %>
        </div>
      </nav>
    <% end %>

    <% if notice.present? %>
      <div class="kt-flash">
        <div class="kt-flash__notice"><%= notice %></div>
      </div>
    <% end %>
    <% if alert.present? && user_signed_in? %>
      <div class="kt-flash">
        <div class="kt-flash__alert"><%= alert %></div>
      </div>
    <% end %>

    <% if user_signed_in? %>
      <main class="kt-main"><%= yield %></main>
    <% else %>
      <%= yield %>
    <% end %>
  </body>
</html>
