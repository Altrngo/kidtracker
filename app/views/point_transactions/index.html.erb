<%# app/views/point_transactions/index.html.erb %>
<% color = child_color_name(@child.avatar_color) %>

<div class="kt-page-header">
  <div style="display:flex; align-items:center; gap:.75rem;">
    <div class="kt-child-avatar" data-color="<%= color %>" style="width:40px;height:40px;font-size:1rem;">
      <%= @child.first_name[0].upcase %>
    </div>
    <div>
      <h1>Historique — <%= @child.first_name %></h1>
      <div style="font-size:.85rem; color:var(--text-secondary)">
        Solde actuel : <strong style="color:var(--text-primary)"><%= @child.total_points %> pts</strong>
      </div>
    </div>
  </div>
  <%= link_to "Nouveau mouvement", new_child_point_transaction_path(@child),
        class: "kt-btn kt-btn--primary kt-btn--sm" %>
</div>

<% if @transactions.empty? %>
  <div class="kt-empty">
    <div class="kt-empty__icon">📋</div>
    <p class="kt-empty__title">Aucune transaction</p>
    <p class="kt-empty__text">Les points crédités et dépensés apparaîtront ici.</p>
  </div>
<% else %>
  <div class="kt-tx-list">
    <% @transactions.each do |tx| %>
      <div class="kt-tx">
        <div class="kt-tx__icon"><%= tx.icon %></div>

        <div class="kt-tx__body">
          <div class="kt-tx__label"><%= tx.label %></div>
          <div class="kt-tx__meta">
            <%= l(tx.created_at, format: :short) rescue tx.created_at.strftime("%d/%m/%Y à %H:%M") %>
            <% if tx.user %>
              · par <span class="kt-tx__author"><%= tx.user.display_name %></span>
            <% end %>
          </div>
        </div>

        <div class="kt-tx__amount <%= tx_class(tx.amount) %>">
          <%= tx.sign %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>

<div style="margin-top:1rem;">
  <%= link_to "Retour au profil", child_path(@child), class: "kt-btn kt-btn--ghost kt-btn--sm" %>
</div>
