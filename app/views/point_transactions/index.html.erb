<%# app/views/point_transactions/index.html.erb %>
<% color = child_color_name(@child.avatar_color) %>

<div class="kt-page-header">
  <div style="display:flex; align-items:center; gap:.75rem;">
    <div class="kt-child-avatar" data-color="<%= color %>" style="width:38px;height:38px;font-size:.95rem;">
      <%= @child.first_name[0].upcase %>
    </div>
    <div>
      <h1>Historique — <%= @child.first_name %></h1>
      <div style="font-size:.85rem; color:var(--text-secondary);">
        Solde actuel : <strong style="color:var(--text-primary)"><%= @child.total_points %> pts</strong>
      </div>
    </div>
  </div>
  <%= link_to "Nouveau mouvement", new_child_point_transaction_path(@child), class: "kt-btn kt-btn--primary kt-btn--sm" %>
</div>

<% if @transactions.empty? %>
  <div class="kt-card" style="text-align:center; padding:2.5rem; color:var(--text-secondary)">
    <p>Aucune transaction enregistrée.</p>
  </div>
<% else %>
  <div class="kt-card" style="padding:0; overflow:hidden;">
    <table class="kt-table">
      <thead>
        <tr>
          <th>Date</th>
          <th>Motif</th>
          <th style="text-align:right">Points</th>
        </tr>
      </thead>
      <tbody>
        <% @transactions.each do |tx| %>
          <tr>
            <td style="color:var(--text-secondary); font-size:.8rem; white-space:nowrap;">
              <%= tx.created_at.strftime("%d/%m/%Y") %>
            </td>
            <td>
              <% if tx.redemption? %>
                <span style="margin-right:.35rem;">🎁</span>
              <% elsif tx.amount.positive? %>
                <span style="margin-right:.35rem;">⭐</span>
              <% else %>
                <span style="margin-right:.35rem;">✏️</span>
              <% end %>
              <%= tx.label %>
            </td>
            <td style="text-align:right;">
              <span class="kt-tx-amount <%= tx_class(tx.amount) %>">
                <%= tx.sign %>
              </span>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

<div style="margin-top:1rem;">
  <%= link_to "Retour au profil", child_path(@child), class: "kt-btn kt-btn--ghost kt-btn--sm" %>
</div>