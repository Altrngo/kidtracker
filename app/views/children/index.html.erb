<div class="kt-page-header">
  <h1>Enfants</h1>
  <%= link_to "Ajouter un enfant", new_child_path, class: "kt-btn kt-btn--primary" %>
</div>

<% if @children.empty? %>
  <div class="kt-card" style="text-align:center; padding:3rem 1.5rem; color:var(--text-secondary)">
    <p style="font-size:2.5rem; margin-bottom:.75rem">👶</p>
    <p style="font-weight:500">Aucun enfant enregistré</p>
  </div>
<% else %>
  <div class="kt-child-grid">
    <% @children.each do |child| %>
      <% color = child_color_name(child.avatar_color) %>
      <div class="kt-child-card" data-color="<%= color %>" style="cursor:default">
        <div class="kt-child-avatar" data-color="<%= color %>">
          <%= child.first_name[0].upcase %>
        </div>
        <div class="kt-child-name"><%= child.first_name %></div>
        <div class="kt-child-sub"><%= child.child_items.active.count %> items actifs</div>
        <div class="kt-child-score">
          <%= child.total_points %>
          <span class="kt-child-score__unit">pts</span>
        </div>
        <div style="display:flex; gap:.5rem; margin-top:1rem; flex-wrap:wrap;">
          <%= link_to "Tableau", child_weeks_path(child), class: "kt-btn kt-btn--primary kt-btn--sm" %>
          <%= link_to "Profil", child_path(child), class: "kt-btn kt-btn--ghost kt-btn--sm" %>
          <%= link_to "Points", new_child_point_transaction_path(child), class: "kt-btn kt-btn--ghost kt-btn--sm" %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>