<%# app/views/dashboard/index.html.erb %>
<div class="kt-page-header">
  <h1>Tableau de bord</h1>
  <%= link_to "Ajouter un enfant", new_child_path, class: "kt-btn kt-btn--primary kt-btn--sm" %>
</div>

<% if @children.empty? %>
  <div class="kt-card" style="text-align:center; padding: 3rem 1.5rem; color: var(--text-secondary);">
    <p style="font-size: 2.5rem; margin-bottom: 1rem;">👨‍👩‍👧‍👦</p>
    <p style="font-weight: 500; margin-bottom: .5rem;">Aucun enfant enregistré</p>
    <%= link_to "Ajouter un premier enfant", new_child_path, class: "kt-btn kt-btn--primary" %>
  </div>
<% else %>
  <div class="kt-child-grid">
    <% @children.each do |child| %>
      <%# Détermine la couleur depuis avatar_color (ex: "#378ADD" → "blue") %>
      <% color = child_color_name(child.avatar_color) %>
      <%= link_to child_weeks_path(child), class: "kt-child-card", data: { color: color } do %>
        <div class="kt-child-avatar" data-color="<%= color %>">
          <%= child.first_name[0].upcase %>
        </div>
        <div class="kt-child-name"><%= child.first_name %></div>
        <div class="kt-child-sub"><%= child.child_items.active.count %> items actifs</div>
        <div class="kt-child-score">
          <%= child.total_points %>
          <span class="kt-child-score__unit">pts</span>
        </div>
      <% end %>
    <% end %>
  </div>
<% end %>